---
const vehicles = [
    { name:"Car", model: "/models/Car.glb" , orbit: "-90deg -90deg auto"},
    { name:"Car2", model: "/models/car2.glb", orbit: "auto auto auto"},
    {name:"Police", model:"/models/police.glb", orbit:"auto auto auto"}
]
---

<div class="hidden md:block">
    <ul class="flex gap-5">
        {vehicles.map((vehicle) => {
            return (
                <li class="vehicle-item" data-vehicle={JSON.stringify(vehicle)}>
                    <button class="flex flex-col items-center p-1 rounded-xl bg-black/10 backdrop-blur-md border border-black/20 hover:bg-black/20 transition-all">
                        <model-viewer
                            src={vehicle.model}
                            camera-orbit={vehicle.orbit}
                            interaction-prompt="none"
                            camera-orbit = "auto"
                            loading="lazy"
                            class="w-10 h-10 sm:w-12 sm:h-12"
                        ></model-viewer>
                    </button>
                </li>
            );
        })}
    </ul>
</div>

<script>
    const vehicleItems = document.querySelectorAll('.vehicle-item');
    const vehicleModel = document.getElementById('vehicle') as HTMLModelViewerElement;

    vehicleItems.forEach((item) => {
        item.addEventListener('click', () => {
            const vehicle = JSON.parse(item.getAttribute('data-vehicle') || '{}') as any;
            vehicleModel.src = vehicle.model;
            vehicleModel.cameraOrbit = vehicle.orbit;
        });
    });
</script>