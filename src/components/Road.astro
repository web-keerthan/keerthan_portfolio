---
import Vehicles from "./Vehicles.astro";
---
<div id="path-container">
    <svg id="dynamic-road-svg" class="absolute inset-0 w-full h-full pointer-events-none z-0">
    </svg>

    <div id="vehicle-path" class="absolute inset-0 w-full h-full pointer-events-none z-[-10]"></div>

    <Vehicles />
</div>

<script>
    import {buildRoad} from "../utils/buildRoad";
    import {initPathFollow} from "../utils/pathFollow";

    function update(){
        const roadSvg = document.querySelector('#dynamic-road-svg');
        const pathContainer = document.querySelector('#vehicle-path');
        const cards = document.querySelectorAll('.project-card');
        const header = document.querySelector('#section-header');
        const content = document.querySelector('body');

        buildRoad(roadSvg,cards,header, content, pathContainer);
        initPathFollow();
    }

    window.addEventListener('DOMContentLoaded', update);
    window.addEventListener('load', update);
    window.addEventListener('resize', update);

    const container = document.querySelector('section');
    if (container && typeof ResizeObserver !== 'undefined') {
        const ro = new ResizeObserver(update);
        ro.observe(container);
    }

    update();
</script>
